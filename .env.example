# Copy this file to `.env` at the repo root and fill in your keys.
#
# Required for LLM features (Chat, Research agent, semantic search,
# auto-summary + auto-tags on save). Leave blank + set ENABLE_LLM=false
# below to run BrowseFellow as a plain reader.
COHERE_API_KEY=

# Optional — powers the Research agent's web-search tool.
# Sign up at tavily.com (free tier: 1000 searches/month).
TAVILY_API_KEY=

# LLM features on/off (true/false). When false, the reader still works
# but Chat / Research / summaries / auto-tags / semantic search are skipped.
ENABLE_LLM=true

# Cohere model IDs. Defaults are fine for most users.
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-english-v3.0

# Backend server port.
PORT=8765

# Where the SQLite shelf lives. Defaults to ~/ReaderData if unset.
# DATA_DIR=/path/to/ReaderData

# --- Text generation provider -------------------------------------------
# Scoring, the daily brief and summaries run on whichever of these you set.
# LLM_PROVIDER=auto picks Anthropic, then OpenAI, then Cohere.
# EMBEDDINGS ALWAYS USE COHERE: semantic search and Discover clustering
# compare against vectors already stored in the database, and vectors from
# two different embedding models are not comparable. Keep COHERE_API_KEY set
# even if you generate text elsewhere.
LLM_PROVIDER=auto
# LLM_MODEL=
# LLM_BASE_URL=http://localhost:11434/v1   # for LLM_PROVIDER=openai-compatible

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=

# Scoring runs on every article; the brief runs once a day.
# DISCOVER_SCORE_MODEL=claude-sonnet-5-5
# DISCOVER_DIGEST_MODEL=claude-opus-5-5
